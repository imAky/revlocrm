# ==============================================================================
# REVLO CRM ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SESSION SECURITY (Jose HS256 Encrypted JWT Cookie)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long
SESSION_SECRET="revlo-crm-production-encryption-secret-key-32chars-minimum"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL ENGINE (Resend OTP & Workspace Invitations)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# Must be a verified domain on Resend (or onboarding@resend.dev for sandbox testing)
RESEND_FROM_EMAIL="Revlo CRM <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. APPLICATION HOST URL (Production Host Resolution for Invitations)
# ------------------------------------------------------------------------------
# Required for generating real production invitation and login links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. GOOGLE 1-CLICK SSO AUTHENTICATION (Google Cloud Console OAuth 2.0)
# ------------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 6. OPTIONAL: ASSET & MEDIA STORAGE (Cloudflare R2 / Cloudinary)
# ------------------------------------------------------------------------------
# Cloudflare R2 S3-Compatible Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="revlocrm-media"
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-<account-id>.r2.dev"

# Cloudinary Storage (Alternative)
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
